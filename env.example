GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_CHANNELS=  # Comma-separated chat_id[:thread_id], e.g. "-1001:12,-1002"

# CLA Assistant
CLA_ENABLED=true
CLA_DOCUMENT_URL=https://github.com/a1y-developer/.github/blob/main/CLA.md
CLA_SIGNATURES_REPO=a1y-developer/cla.db
CLA_SIGNATURES_PATH=signatures/version1/cla.json
CLA_SIGNATURES_BRANCH=main
CLA_ALLOWLIST=bot
CLA_SIGN_PHRASE='I have read the CLA Document and I hereby sign the CLA'
CLA_RECHECK_PHRASE=recheck
CLA_LOCK_AFTER_MERGE=true
